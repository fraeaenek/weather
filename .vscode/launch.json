{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FastAPI",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["web.backend.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "jinja": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
